,howTo:"How it works",myAccount:"My account",myDocuments:"My documents",newDocument:"New document",pricing:"Prices",privacy:"Privacy Policy",terms:"Terms of Use and Contract",unsubscribe:"Unsubscribe",users:"Users"},cC={description:"The page you are trying to access does not exist or is not available.",editorDescription:"This document is no longer available."},uC={billing:"Billing",checkout:"Checkout",contact:"Contact Us - PDFe",cookies:"Cookies policy",editor:"Editor - PDFe",editorNotFound:"PDF not found",faqs:"Frequently Asked Questions - PDFe",gdpr:"General Data Protection Regulation",home:"Free Online PDF Editor - PDFe",howTo:"How it works",myAccount:"My account",myDocuments:"My documents",newDocument:"New document",notFound:"Page not found",pricing:"Plans and Pricing - PDFe",privacy:"Privacy Policy",terms:"Terms of Use and Contract",users:"Users"},dC={buttonNext:"Go to next page",buttonPrevious:"Go to previous page",morePages:"More pages",navLabel:"pagination"},fC={added:"Added",details:"Detail",header:"Everything ready to start",paid:"Paid!",planModules:{service:{description:"Immediate and personalized assistance, available whenever you need it.",features:[{description:"Your inquiries come first: resolve urgent issues in minutes, not days.",title:"Faster responses"},{description:"Speak directly with specialists who know the platform inside and out.",title:"Personalized attention"},{description:"From technical issues to advanced setup, we're here to help.",title:"Comprehensive assistance"},{description:"Day or night, our team is here for you 7 days a week.",title:"Always available"}],title:"24/7 Priority Support"},trial:{description:"All the tools you need to work with your documents",features:[{description:"Add, delete, or modify text, images, and links directly in the PDF.",title:"Edit content"},{description:"Reduce the size of your documents while maintaining the best quality.",title:"Compress files"},{description:"Combine multiple PDFs, split them into sections, or reorder and rotate pages in seconds.",title:"Manage Pages"},{description:"Add your digital signature easily and securely, ready to share.",title:"Sign documents"}],title:"Editing PDFs"}},title:"You can now use all PDFe tools and enjoy 24/7 support."},pC={billing:{month:"month",year:"year"},fraud:{name:"Fraud"},monthly:{description:"It will automatically renew unless you cancel the subscription.",name:"Monthly plan",periodicity:"Billed monthly"},quartetly:{name:"Quartetly Plan",periodicity:"Billed every four months"},trial:{description:`With the 7-day trial plan, you can enjoy the service with limitations before deciding to upgrade to the next plan to unlock all features.
After that period, the plan automatically renews to the monthly plan; you can cancel at any time.`,name:"Trial plan",periodicity:"Single payment"},yearly:{name:"Annual Plan",periodicity:"Billed annually"}},mC={faqSection:{faqs:[{answer:"Yes, during the 7-day trial you’ll have access to all features of the editor. The only limitations are: you won’t be able to add collaborators to your account, you can process up to 3 documents per day, and your files will be stored for 24 hours from the time they are created or edited.",question:"Can I try all features during the trial period?"},{answer:"The trial lasts 7 days and costs just {{trialPrice}}. If you don’t cancel before it ends, your subscription will automatically renew to the monthly plan for {{monthlyPrice}}, giving you full access to all features. You can cancel anytime from your account settings.",question:"What happens after the 7-day trial ends?"},{answer:"No, the monthly subscription has no long-term commitment. You can cancel at any time from your account, and you won’t be charged again after the current billing period.",question:"Is there a commitment with the monthly subscription?"},{answer:"Yes, you can cancel anytime from the billing section of your account. You’ll continue to have access to your plan until the end of the current billing cycle.",question:"Can I cancel my subscription at any time?"},{answer:"We don’t offer refunds for active subscriptions that haven’t been used. If you no longer wish to continue, we recommend canceling your plan before the next renewal date.",question:"Can I request a refund for an unused subscription?"}],title:"Frequently Asked Questions"},title:"Choose the plan that best suits you"},hC={billings:"Billing",contact:"Contact",myAccount:"My account",myDocuments:"My documents",newDocument:"New document",settings:"Settings",users:"Users"},gC={contact:{description:"Need help or have a question? Contact our team for support, partnership inquiries, or feedback. We’re here to assist you with anything related to PDFe."},description:"Edit PDFs effortlessly with our free online PDF editor—add text, images, comments, annotations, fill & sign forms, and more. No watermarks, no sign-up required",faqs:{description:"Find quick answers to common questions about PDF editing, subscriptions, billing, features, and more. Explore our FAQs for everything you need to get started."},pricing:{description:"Access all premium PDF editing and signing features with our subscription plans. Start with a {{trialDays}}-day trial at a reduced price, then continue with unlimited monthly access."}},vC={alreadyUnsubscribed:"Your subscription has been canceled on PDFe, and you will no longer receive charges to your card.",form:{back:"Back to top",button:"Unsubscribe",email:"Email",fullfilled:{description:"Your account will no longer be charged.",title:"Your subscription has been successfully canceled."},note:"Don't remember which email address you used to register? Contact us through the <anchor>contact</anchor> section and we'll help you figure it out.",placeholder:{email:"Hello@email.com"}},genericError:"We were unable to process your request. Please contact us at support@pdfe.com for assistance.",help:{note:"We will respond as soon as possible. Please allow up to 24 hours for a response.",subtitle:"If you have any questions about your subscription or using the platform, please email us at <anchor>support@pdfe.com</anchor.",title:"Do you need help?"},invalidEmail:"There is no account with this email address.",main:{subtitle:"Please confirm your email address to unsubscribe from <strong>PDFe.</strong>",title:"Unsubscribe"},monthly:{description:"Once the trial period ends, your monthly subscription is automatically activated unless you cancel it beforehand. You can unsubscribe at any time from this page.",functions:["Unlimited <strong>editions</strong>","<strong>Unlimited</strong> conversions to other formats ","Storage of PDFs <strong>without time limit</strong>","Reorgan